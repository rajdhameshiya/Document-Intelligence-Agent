{
  "name": "shipmnts-doc-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm start --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "render-build": "npm install --prefix server && npm install --prefix client --legacy-peer-deps && npm run build:client && npm run build:server",
    "start": "npm start --prefix server"
  }
}
